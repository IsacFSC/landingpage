---
import Layout from "../layouts/Layout.astro";
import Testimonials from "../components/Testimonials.jsx";
import Hero from "../components/sections/Hero.tsx";
import Services from "../components/sections/Services.tsx";
import Contact from "../components/sections/Contact.tsx";
import Navbar from "../components/Navbar.tsx"; 
import { MessageCircle } from "lucide-react";
import TypingWords from "@/components/TypingWords";

---

<Layout title="Sites que geram clientes | DS Desenvolvimento">

  <!-- HEADER (clean + reusable pattern) -->
  <header class="fixed top-0 w-full z-50 border-b border-white/5 bg-background/80 backdrop-blur-xl transition-all duration-300">
    <Navbar client:load />
  </header>

  <div class="fixed inset-0 -z-20 bg-brand-black dark:bg-brand-black pointer-events-none" />

  <main class="pt-16">

    <Hero client:load />

    <Services client:visible />

    <section id="resultados" class="px-4 py-20 bg-muted/30">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-2xl md:text-4xl font-bold mb-12">Resultados reais</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card p-8 bg-brand-primary/5 border-brand-primary/10">
            <h4 class="text-4xl font-bold text-brand-primary">+340%</h4>
            <p class="font-semibold mt-2">Crescimento em Vendas</p>
            <p class="text-sm text-muted-foreground mt-2">Estratégia completa de conversão.</p>
          </div>
          <div class="card p-8">
            <h4 class="text-4xl font-bold text-brand-primary">#1</h4>
            <p class="font-semibold mt-2">Liderança Local</p>
            <p class="text-sm text-muted-foreground mt-2">Domínio absoluto no Google Maps.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="px-4 py-20">
      <Testimonials client:visible />
    </section>

    <!-- CTA FINAL -->
    <!-- CONTATO -->
	<section
	id="contato"
	class="relative overflow-hidden px-4 py-24"
	>
	<!-- Background Glow -->
	<div class="absolute inset-0 -z-10">
		<div class="absolute left-1/2 top-0 h-[400px] w-[400px] -translate-x-1/2 rounded-full bg-green-500/10 blur-3xl" />
		<div class="absolute bottom-0 right-0 h-[300px] w-[300px] rounded-full bg-emerald-500/10 blur-3xl" />
	</div>

	<div class="mx-auto max-w-5xl">

		<!-- Heading -->
		<div class="mx-auto mb-14 max-w-2xl text-center">
		<span class="badge mb-5">
			Contato
		</span>

		<h2 class="text-3xl mt-6 font-bold tracking-tight text-white md:text-5xl">
			Vamos transformar sua presença digital
			em uma máquina de geração de clientes
		</h2>

		<p class="mt-5 text-base leading-relaxed text-white/60 md:text-lg">
			Entre em contato agora mesmo e descubra como criar
			um site premium com alta conversão, SEO local e
			performance extrema.
		</p>
		</div>

		<!-- Contact Cards -->
		<div class="grid gap-6 md:grid-cols-2">

		<!-- WhatsApp -->
		<a
			href="https://wa.me/5567981178782"
			target="_blank"
			class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-green-500/40 hover:bg-green-500/10"
		>
			<!-- Glow -->
			<div class="absolute inset-0 bg-gradient-to-br from-green-500/10 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>

			<div class="relative z-10">
			<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-green-500/15 text-green-400 shadow-lg shadow-green-500/20 transition-transform duration-500 group-hover:scale-110">
				
				<!-- Whats SVG -->
				<svg
				xmlns="http://www.w3.org/2000/svg"
				width="34"
				height="34"
				viewBox="0 0 24 24"
				fill="currentColor"
				>
				<path
					d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2C6.53 2 2.06 6.47 2.06 11.97c0 1.76.46 3.48 1.34 5L2 22l5.18-1.36a9.93 9.93 0 0 0 4.85 1.24h.01c5.5 0 9.97-4.47 9.97-9.97a9.9 9.9 0 0 0-2.96-7ZM12.04 20.2h-.01a8.3 8.3 0 0 1-4.22-1.15l-.3-.18-3.08.81.82-3-.2-.31a8.27 8.27 0 0 1-1.28-4.4c0-4.58 3.72-8.3 8.3-8.3 2.22 0 4.3.86 5.87 2.43a8.24 8.24 0 0 1 2.43 5.87c0 4.58-3.72 8.3-8.33 8.3Zm4.56-6.23c-.25-.13-1.47-.73-1.7-.81-.23-.09-.4-.13-.57.13-.17.25-.65.81-.8.97-.14.17-.3.19-.55.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.25-1.47-1.4-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.3.38-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.57-1.38-.78-1.89-.2-.49-.41-.42-.57-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.43 1.03 2.6.13.17 1.77 2.7 4.3 3.79.6.26 1.07.42 1.43.53.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.29Z"
				/>
				</svg>
			</div>

			<h3 class="text-2xl font-semibold text-white">
				WhatsApp
			</h3>

			<p class="mt-3 text-sm leading-relaxed text-white/60">
				Atendimento rápido para orçamento, dúvidas
				e estratégias digitais personalizadas.
			</p>

			<div class="mt-8 flex items-center gap-2 text-green-400">
				<span class="font-medium">
				Falar agora
				</span>

				<span class="transition-transform duration-300 group-hover:translate-x-1">
				→
				</span>
			</div>
			</div>
		</a>

		<!-- EMAIL -->
		<a
			href="mailto:contato@dsdesenvolvimento.com.br"
			class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-white/20 hover:bg-white/10"
		>
			<!-- Glow -->
			<div class="absolute inset-0 bg-gradient-to-br from-slate-500/10 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>

			<div class="relative z-10">
			<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-white shadow-lg shadow-white/10 transition-transform duration-500 group-hover:scale-110">

				<!-- Mail SVG -->
				<svg
				xmlns="http://www.w3.org/2000/svg"
				width="32"
				height="32"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
				>
				<rect width="20" height="16" x="2" y="4" rx="2"/>
				<path d="m22 7-8.97 5.7a2 2 0 0 1-2.06 0L2 7"/>
				</svg>
			</div>

			<h3 class="text-2xl font-semibold text-white">
				E-mail
			</h3>

			<p class="mt-3 text-sm leading-relaxed text-white/60">
				Receba uma análise estratégica detalhada
				para seu projeto, empresa ou campanha.
			</p>

			<div class="mt-8 flex items-center gap-2 text-white">
				<span class="font-medium">
				Enviar agora
				</span>

				<span class="transition-transform duration-300 group-hover:translate-x-1">
				→
				</span>
			</div>
			</div>
		</a>

		</div>
	</div>
	</section>
  </main>

  <!-- FLOAT BUTTON -->
  <a
	href="https://wa.me/5567981178782"
	class="whatsapp-float group"
	aria-label="Falar no WhatsApp"
  >
	{/* ripple */}
	<span class="pulse-ring" />

	{/* botão */}
	<span class="relative z-50 bg-green-500 text-white rounded-full shadow-2xl transition-transform duration-300 group-hover:scale-110 active:scale-95">
		{/* SVG */}
		<svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="50" height="50" viewBox="0 0 48 48">
		<path fill="#fff" d="M4.9,43.3l2.7-9.8C5.9,30.6,5,27.3,5,24C5,13.5,13.5,5,24,5c5.1,0,9.8,2,13.4,5.6	C41,14.2,43,18.9,43,24c0,10.5-8.5,19-19,19c0,0,0,0,0,0h0c-3.2,0-6.3-0.8-9.1-2.3L4.9,43.3z"></path><path fill="#fff" d="M4.9,43.8c-0.1,0-0.3-0.1-0.4-0.1c-0.1-0.1-0.2-0.3-0.1-0.5L7,33.5c-1.6-2.9-2.5-6.2-2.5-9.6	C4.5,13.2,13.3,4.5,24,4.5c5.2,0,10.1,2,13.8,5.7c3.7,3.7,5.7,8.6,5.7,13.8c0,10.7-8.7,19.5-19.5,19.5c-3.2,0-6.3-0.8-9.1-2.3	L5,43.8C5,43.8,4.9,43.8,4.9,43.8z"></path><path fill="#cfd8dc" d="M24,5c5.1,0,9.8,2,13.4,5.6C41,14.2,43,18.9,43,24c0,10.5-8.5,19-19,19h0c-3.2,0-6.3-0.8-9.1-2.3	L4.9,43.3l2.7-9.8C5.9,30.6,5,27.3,5,24C5,13.5,13.5,5,24,5 M24,43L24,43L24,43 M24,43L24,43L24,43 M24,4L24,4C13,4,4,13,4,24	c0,3.4,0.8,6.7,2.5,9.6L3.9,43c-0.1,0.3,0,0.7,0.3,1c0.2,0.2,0.4,0.3,0.7,0.3c0.1,0,0.2,0,0.3,0l9.7-2.5c2.8,1.5,6,2.2,9.2,2.2	c11,0,20-9,20-20c0-5.3-2.1-10.4-5.8-14.1C34.4,6.1,29.4,4,24,4L24,4z"></path><path fill="#40c351" d="M35.2,12.8c-3-3-6.9-4.6-11.2-4.6C15.3,8.2,8.2,15.3,8.2,24c0,3,0.8,5.9,2.4,8.4L11,33l-1.6,5.8	l6-1.6l0.6,0.3c2.4,1.4,5.2,2.2,8,2.2h0c8.7,0,15.8-7.1,15.8-15.8C39.8,19.8,38.2,15.8,35.2,12.8z"></path><path fill="#fff" fill-rule="evenodd" d="M19.3,16c-0.4-0.8-0.7-0.8-1.1-0.8c-0.3,0-0.6,0-0.9,0	s-0.8,0.1-1.3,0.6c-0.4,0.5-1.7,1.6-1.7,4s1.7,4.6,1.9,4.9s3.3,5.3,8.1,7.2c4,1.6,4.8,1.3,5.7,1.2c0.9-0.1,2.8-1.1,3.2-2.3	c0.4-1.1,0.4-2.1,0.3-2.3c-0.1-0.2-0.4-0.3-0.9-0.6s-2.8-1.4-3.2-1.5c-0.4-0.2-0.8-0.2-1.1,0.2c-0.3,0.5-1.2,1.5-1.5,1.9	c-0.3,0.3-0.6,0.4-1,0.1c-0.5-0.2-2-0.7-3.8-2.4c-1.4-1.3-2.4-2.8-2.6-3.3c-0.3-0.5,0-0.7,0.2-1c0.2-0.2,0.5-0.6,0.7-0.8	c0.2-0.3,0.3-0.5,0.5-0.8c0.2-0.3,0.1-0.6,0-0.8C20.6,19.3,19.7,17,19.3,16z" clip-rule="evenodd"></path>
		</svg>
	</span>
  </a>

</Layout>