---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Testimonials from '../components/Testimonials.vue';
---

<Layout title="DS Desenvolvimento | Transforme Visitantes em Clientes com Estratégias de Elite">
	<header class="fixed w-full z-50 bg-white/40 dark:bg-[#020617]/40 backdrop-blur-xl border-b border-white/20 dark:border-white/10">
		<nav class="container mx-auto px-6 py-4 flex justify-between items-center">
			<div class="text-2xl font-bold text-vue-blue dark:text-vue-green flex items-center gap-2">
				<div class="w-8 h-8 bg-vue-green rounded-lg flex items-center justify-center">
					<div class="w-4 h-4 bg-white rounded-sm"></div>
				</div>
				<span class="hidden sm:inline">DS<span class="text-vue-green dark:text-white">Desenvolvimento</span></span>
			</div>
			<div class="flex space-x-4 md:space-x-8 items-center">
				<a href="#servicos" class="hidden md:inline hover:text-vue-green transition-colors font-medium">Soluções</a>
				<a href="#portfolio" class="hidden md:inline hover:text-vue-green transition-colors font-medium">Resultados</a>
				<ThemeToggle />
				<a href="#contato" class="bg-vue-green text-white px-5 py-2 rounded-xl font-bold hover:shadow-[0_0_20px_rgba(66,184,131,0.5)] transition-all text-sm md:text-base">
					Começar Agora
				</a>
			</div>
		</nav>
	</header>

	<main>
		<!-- [A] ATENÇÃO: Hero Section -->
		<section class="relative pt-32 pb-8 px-6 overflow-hidden">
			<!-- Background effects -->
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10">
				<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-vue-green/20 rounded-full blur-[120px] animate-pulse"></div>
				<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-vue-blue/20 rounded-full blur-[120px]"></div>
			</div>

			<div class="container mx-auto text-center max-w-5xl">
				<div class="inline-block px-4 py-2 rounded-full bg-vue-green/10 text-vue-green font-bold text-sm mb-6 animate-float">
					🚀 O próximo nível do seu faturamento começa aqui
				</div>
				<h1 class="text-5xl md:text-7xl font-bold mb-8 text-vue-blue dark:text-white leading-[1.1] tracking-tight">
					Seu negócio está <span class="text-vue-green italic underline decoration-vue-green/30">perdendo dinheiro</span> com um site amador?
				</h1>
				<p class="text-xl md:text-2xl mb-12 text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
					Não construímos apenas sites. Criamos <strong>máquinas de vendas</strong> de alta performance que dominam o Google e convertem visitantes em lucro real.
				</p>
				<div class="flex flex-col sm:flex-row justify-center gap-6">
					<a href="https://wa.me/5567981178782?text=Olá! Quero transformar meu site em uma máquina de vendas." 
					   class="liquid-glass bg-vue-green text-white px-10 py-5 rounded-2xl text-xl font-extrabold hover:scale-105 hover:shadow-vue-green/20 transition-all flex items-center justify-center gap-3">
						Dominar meu mercado agora
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
					</a>
				</div>
				<div class="container mx-auto">

				<div class="max-w-5xl mb-20 pt-32">
					<h2 class="text-4xl md:text-5xl font-bold mb-6 text-vue-blue dark:text-white">Por que somos a escolha das empresas que <span class="text-vue-green">lideram o mercado</span>?</h2>
					<p class="text-xl text-gray-600 dark:text-gray-400">Enquanto outros focam em "layout bonitinho", nós focamos em resultados.</p>
				</div>
			</div>
		</section>

		

		<!-- [I] INTERESSE: Services Section -->
		<section id="servicos" class="py-8 px-6 relative bg-white dark:bg-[#020617]">

				
				<div class="grid md:grid-cols-3 gap-8">
					<!-- Dev Card -->
					<div class="glass-card p-10 rounded-3xl hover:translate-y-[-12px] transition-all duration-500 group">
						<div class="w-16 h-16 bg-vue-green/20 text-vue-green rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
						</div>
						<h3 class="text-2xl font-bold mb-4 text-vue-blue dark:text-white">Sites de Elite</h3>
						<p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-6">Desenvolvemos Landing Pages com <strong>Astro</strong> e <strong>Vue.js</strong> que carregam em milissegundos. Velocidade é conversão.</p>
						<ul class="space-y-3 text-sm font-medium text-vue-green">
							<li class="flex items-center gap-2">✓ 100/100 no Lighthouse</li>
							<li class="flex items-center gap-2">✓ Mobile-First Real</li>
						</ul>
					</div>

					<!-- Ads Card -->
					<div class="glass-card p-10 rounded-3xl hover:translate-y-[-12px] transition-all duration-500 group border-vue-green/20">
						<div class="w-16 h-16 bg-blue-500/20 text-blue-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
						</div>
						<h3 class="text-2xl font-bold mb-4 text-vue-blue dark:text-white">Tráfego de Guerra</h3>
						<p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-6">Gestão implacável de anúncios no Google e Meta. Capturamos a demanda de quem já quer comprar de você.</p>
						<ul class="space-y-3 text-sm font-medium text-blue-500">
							<li class="flex items-center gap-2">✓ Foco total em ROI</li>
							<li class="flex items-center gap-2">✓ Dashboards em Tempo Real</li>
						</ul>
					</div>

					<!-- SEO Card -->
					<div class="glass-card p-10 rounded-3xl hover:translate-y-[-12px] transition-all duration-500 group">
						<div class="w-16 h-16 bg-orange-500/20 text-orange-500 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
						</div>
						<h3 class="text-2xl font-bold mb-4 text-vue-blue dark:text-white">Domínio Local</h3>
						<p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-6">Seja a primeira opção no Google Maps. Se eles não te encontram, eles compram do seu vizinho.</p>
						<ul class="space-y-3 text-sm font-medium text-orange-500">
							<li class="flex items-center gap-2">✓ Posicionamento no Topo</li>
							<li class="flex items-center gap-2">✓ Autoridade Regional</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- [D] DESEJO: Portfolio Section -->
		<section id="portfolio" class="py-8 bg-gray-50 dark:bg-[#0f172a]/30 relative">
			<div class="container mx-auto px-6">
				<div class="text-center max-w-2xl mx-auto mb-20">
					<h2 class="text-4xl font-bold mb-6 text-vue-blue dark:text-white">Resultados que falam por si</h2>
					<p class="text-gray-600 dark:text-gray-400">Cases reais de empresas que saíram da invisibilidade para a liderança digital.</p>
				</div>
				
				<div class="grid md:grid-cols-2 gap-12">
					<div class="group relative overflow-hidden rounded-3xl glass-card p-4 transition-all duration-500">
						<div class="aspect-video bg-vue-blue rounded-2xl overflow-hidden mb-6">
							<div class="w-full h-full bg-gradient-to-tr from-vue-blue to-vue-green opacity-40 group-hover:opacity-20 transition-all"></div>
						</div>
						<div class="px-4 pb-4">
							<span class="text-vue-green font-bold text-sm tracking-widest uppercase">E-commerce de Luxo</span>
							<h4 class="text-2xl font-bold mt-2 mb-4 text-vue-blue dark:text-white">+340% em vendas em 6 meses</h4>
							<p class="text-gray-600 dark:text-gray-300">Reestruturação completa de Landing Pages e estratégia agressiva de Google Shopping.</p>
						</div>
					</div>

					<div class="group relative overflow-hidden rounded-3xl glass-card p-4 transition-all duration-500">
						<div class="aspect-video bg-vue-green rounded-2xl overflow-hidden mb-6">
							<div class="w-full h-full bg-gradient-to-tr from-vue-green to-vue-blue opacity-40 group-hover:opacity-20 transition-all"></div>
						</div>
						<div class="px-4 pb-4">
							<span class="text-vue-green font-bold text-sm tracking-widest uppercase">Clínica Odontológica</span>
							<h4 class="text-2xl font-bold mt-2 mb-4 text-vue-blue dark:text-white">Domínio total do mercado local</h4>
							<p class="text-gray-600 dark:text-gray-300">SEO Local + Anúncios Geo-localizados resultando em agenda lotada 24/7.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Depoimentos (Prova Social) -->
		<section class="py-8 px-6 overflow-hidden bg-white dark:bg-[#020617]">
			<div class="container mx-auto">
				<div class="text-center max-w-2xl mx-auto mb-8">
					<h2 class="text-4xl font-bold mb-4 text-vue-blue dark:text-white">O que dizem nossos <span class="text-vue-green">parceiros</span></h2>
					<p class="text-gray-600 dark:text-gray-400 text-lg">A confiança de quem já escalou seus resultados conosco.</p>
				</div>
				<Testimonials client:visible />
			</div>
		</section>

		<!-- [A] AÇÃO: Contact Form -->
		<section id="contato" class="py-12 md:py-16 px-4 md:px-6 bg-gray-50 dark:bg-[#0f172a]/30">
  <div class="container mx-auto max-w-4xl">
    <div class="liquid-glass p-6 md:p-12 rounded-3xl md:rounded-[3rem] relative overflow-hidden border border-white/20 dark:border-white/10 w-full">
      <div class="absolute top-0 right-0 w-64 h-64 bg-vue-green/20 rounded-full blur-[80px] -mr-16 -mt-16 pointer-events-none"></div>
      
      <div class="relative z-10 grid md:grid-cols-2 gap-10 md:gap-16 w-full min-w-0">
        <!-- Info -->
        <div class="min-w-0">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 leading-tight text-vue-blue dark:text-white">
            Pronto para o próximo <span class="text-vue-green">salto de escala</span>?
          </h2>
          <p class="text-base md:text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
            Agende uma consultoria gratuita hoje e descubra exatamente onde você está perdendo dinheiro.
          </p>
          <div class="space-y-4">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 flex-shrink-0 rounded-full bg-vue-green/10 flex items-center justify-center text-vue-green">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                </svg>
              </div>
              <span class="font-bold text-vue-blue dark:text-white text-sm md:text-base">+55 (67) 98117-8782</span>
            </div>
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 flex-shrink-0 rounded-full bg-vue-green/10 flex items-center justify-center text-vue-green">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                </svg>
              </div>
              <span class="font-bold text-vue-blue dark:text-white text-sm md:text-base break-all">contato@dsdesenvolvimento.com</span>
            </div>
          </div>
        </div>
        
        <!-- Form -->
        <form class="space-y-4 min-w-0 w-full">
          <input type="text" placeholder="Seu Nome"
            class="w-full px-4 md:px-6 py-4 rounded-2xl bg-white/50 dark:bg-[#020617]/50 border border-white/20 dark:border-white/10 outline-none focus:ring-2 focus:ring-vue-green transition-all text-vue-blue dark:text-white placeholder:text-gray-400 text-sm md:text-base"
            required />
          <input type="email" placeholder="Seu E-mail"
            class="w-full px-4 md:px-6 py-4 rounded-2xl bg-white/50 dark:bg-[#020617]/50 border border-white/20 dark:border-white/10 outline-none focus:ring-2 focus:ring-vue-green transition-all text-vue-blue dark:text-white placeholder:text-gray-400 text-sm md:text-base"
            required />
          <input type="tel" placeholder="Seu WhatsApp"
            class="w-full px-4 md:px-6 py-4 rounded-2xl bg-white/50 dark:bg-[#020617]/50 border border-white/20 dark:border-white/10 outline-none focus:ring-2 focus:ring-vue-green transition-all text-vue-blue dark:text-white placeholder:text-gray-400 text-sm md:text-base"
            required />
          <textarea placeholder="Fale um pouco sobre seu negócio" rows="4"
            class="w-full px-4 md:px-6 py-4 rounded-2xl bg-white/50 dark:bg-[#020617]/50 border border-white/20 dark:border-white/10 outline-none focus:ring-2 focus:ring-vue-green transition-all text-vue-blue dark:text-white placeholder:text-gray-400 resize-none text-sm md:text-base">
          </textarea>
          <button type="submit"
            class="w-full bg-vue-blue dark:bg-vue-green text-white py-4 md:py-5 rounded-2xl font-extrabold text-lg md:text-xl hover:shadow-2xl hover:scale-[1.02] transition-all">
            Enviar e Escalar 🚀
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
	</main>

	<footer class="py-20 border-t border-gray-100 dark:border-white/10 text-center bg-white dark:bg-[#020617]">
		<div class="container mx-auto px-6">
			<div class="text-2xl font-bold mb-8 text-vue-blue dark:text-vue-green">
				DS<span class="text-vue-green dark:text-white">Desenvolvimento</span>
			</div>
			<p class="text-gray-500 mb-8 max-w-md mx-auto">Acelerando negócios com tecnologia de ponta e estratégias de conversão implacáveis.</p>
			<div class="flex justify-center gap-6 mb-12">
				<a href="#" class="hover:text-vue-green transition-colors font-bold">Instagram</a>
				<a href="#" class="hover:text-vue-green transition-colors font-bold">LinkedIn</a>
				<a href="#" class="hover:text-vue-green transition-colors font-bold">WhatsApp</a>
			</div>
			<p class="text-gray-400 text-sm">© 2026 DS Desenvolvimento. Todos os direitos reservados.</p>
		</div>
	</footer>

	<!-- WhatsApp Floating -->
	<a href="https://wa.me/5567981178782" class="fixed bottom-10 right-10 bg-[#25d366] text-white p-5 rounded-[2rem] shadow-[0_10px_40px_rgba(37,211,102,0.4)] hover:scale-110 transition-transform z-50 flex items-center gap-3 group">
		<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
		<span class="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-500 ease-in-out whitespace-nowrap font-extrabold text-lg">
			Escalar meu negócio
		</span>
	</a>
</Layout>
