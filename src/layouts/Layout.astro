---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "Criação de Sites, Landing Pages e SEO Local em Campo Grande MS. Aumente seus clientes com performance e estratégia digital.",
	image = "/brand/brand.jpg"
} = Astro.props;

const siteUrl = "https://landingpage-ds.netlify.app";
const currentUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

/* =========================
   🧠 SEO LOCAL (GEO + Schema)
========================= */
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "DS Desenvolvimento",
  "image": ogImageUrl,
  "@id": siteUrl,
  "url": siteUrl,
  "telephone": "+5567981178782",
  "priceRange": "$$",
  "description": description,

  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Campo Grande",
    "addressLocality": "Campo Grande",
    "addressRegion": "MS",
    "postalCode": "79000-000",
    "addressCountry": "BR"
  },

  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -20.4697,
    "longitude": -54.6201
  },

  "areaServed": [
    {
      "@type": "City",
      "name": "Campo Grande"
    },
    {
      "@type": "Country",
      "name": "Brasil"
    }
  ],

  "serviceType": [
    "Criação de Sites",
    "Landing Pages",
    "SEO Local",
    "Gestão de Tráfego"
  ],

  "sameAs": [
    "https://www.instagram.com/dsdesenvolvimento",
    "https://www.facebook.com/dsdesenvolvimento"
  ]
};
---

<!doctype html>
<html lang="pt-BR" class="dark">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />

	<!-- =========================
	     🔥 SEO PRINCIPAL
	========================= -->
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={currentUrl} />

	<meta name="robots" content="index, follow" />

	<!-- =========================
	     📱 OPEN GRAPH (WhatsApp / Social)
	========================= -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content={currentUrl} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImageUrl} />
	<meta property="og:image:secure_url" content={ogImageUrl} />
	<meta property="og:image:type" content="image/jpeg" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:site_name" content="DS Desenvolvimento" />

	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImageUrl} />

	<!-- =========================
	     🧠 FAVICON / BRAND
	========================= -->
	<link rel="icon" href="/brand/brand.jpg" />
	<link rel="apple-touch-icon" href="/brand/brand.jpg" />

	<!-- =========================
	     ⚡ FONTS (performance)
	========================= -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

	<!-- =========================
	     🧠 STRUCTURED DATA (GEO SEO)
	========================= -->
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>

<body class="font-sans antialiased">
	<main>
		<slot />
	</main>
</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter', system-ui, -apple-system, sans-serif;
		--font-heading: 'Poppins', sans-serif;
	}

	body {
		font-family: var(--font-sans);
	}

	h1, h2, h3, h4 {
		font-family: var(--font-heading);
		letter-spacing: -0.02em;
	}
</style>